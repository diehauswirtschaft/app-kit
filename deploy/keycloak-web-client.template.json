{
  "clientId": "REPLACE_WITH_APP_CLIENT_ID",
  "name": "REPLACE_WITH_APP_DISPLAY_NAME",
  "protocol": "openid-connect",
  "enabled": true,
  "publicClient": false,
  "clientAuthenticatorType": "client-secret",
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "fullScopeAllowed": false,
  "redirectUris": ["https://REPLACE_WITH_APP_ORIGIN/auth/callback"],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256"
  },
  "defaultClientScopes": ["basic", "profile", "roles"],
  "optionalClientScopes": [],
  "protocolMappers": [
    {
      "name": "own-access-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.client.audience": "REPLACE_WITH_APP_CLIENT_ID",
        "access.token.claim": "true",
        "id.token.claim": "false"
      }
    }
  ]
}
